@layout CardLayout
@page "/login"
@using FreePbxTools.Web.Components.Layout
@attribute [AllowAnonymous]

<PageTitle>CCS Bell Schedule - Login</PageTitle>

<div class="card-header text-center">
    <h1>CCS Bell Schedule</h1>
    <a href="http://@_settings.Running.AsteriskHost" target="_blank">Open the FreePBX admin panel</a>
</div>
<div class="card-body">
    <form method="post" action="/api/login">
        
        <div class="d-flex">
            <div class="flex-grow-1">
                <input
                    class="form-control"
                    type="password"
                    name="password"
                    placeholder="Password"
                    autocomplete="current-password"
                    required
                    autofocus/>
            </div>
            <div class="ms-3">
                <button
                    class="btn btn-primary"
                    type="submit">
                    Login
                </button>
            </div>
        </div>

        <input
            type="hidden"
            name="returnUrl"
            value="@ReturnUrl"/>
        <AntiforgeryToken/>
    </form>
</div>
<div class="card-footer">
    <p>
        <span>Questions? Contact your system administrator.</span>
    </p>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }
}
